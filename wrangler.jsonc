{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "notes-and-papers",
	// cache-worker.js puts the edge cache in front of the generated .open-next/worker.js
	"main": "cache-worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"keep_names": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Lets the worker call itself (used by the adapter for ISR revalidation).
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "notes-and-papers"
		}
	],
	// Page cache: one KV namespace used by both bindings. Created with:
	//   npx wrangler kv namespace create NEXT_TAG_CACHE_KV
	"kv_namespaces": [
		{ "binding": "NEXT_TAG_CACHE_KV", "id": "d642f541c5dc4c8a9c8ea3f1747bb1de" },
		{ "binding": "NEXT_INC_CACHE_KV", "id": "d642f541c5dc4c8a9c8ea3f1747bb1de" }
	],
	// Variables and secrets set in the Cloudflare dashboard (INDEXNOW_KEY, REVALIDATE_SECRET) survive every deploy.
	"keep_vars": true,
	"routes": [
		{
			"pattern": "notesandpapers.dpdns.org",
			"custom_domain": true
		},
		{
			"pattern": "www.notesandpapers.dpdns.org",
			"custom_domain": true
		}
	],
	"vars": {
		"INDEXNOW_KEY": "d8e8d88bcb06e2901c2031fe56889b39",
		"NEXT_PUBLIC_SITE_URL": "https://notesandpapers.dpdns.org",
		"NEXT_PUBLIC_API_URL": "https://backend.notesandpapers.dpdns.org/api/v1"
	},
	"observability": {
		"enabled": true
	}
}