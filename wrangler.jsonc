{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "notes-and-papers",
	// Front door: edge cache + retries in front of the app Worker (wrangler.app.jsonc)
	"main": "cache-worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"keep_names": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// The Next.js app runs in its own Worker (wrangler.app.jsonc). This front Worker calls it and retries when it is killed for
	// CPU time (see cache-worker.js). Deploy the app Worker first: npm run cf:deploy does both in order.
	"services": [
		{ "binding": "APP", "service": "notes-and-papers-app" }
	],
	// Saved pages (schema.sql). Created with: npx wrangler d1 create np-pages
	"d1_databases": [
		{ "binding": "DB", "database_name": "np-pages", "database_id": "6a632035-6726-499a-8435-8c737f881b79" }
	],
	// Daily cleanup of saved pages from older deploys (see scheduled() in cache-worker.js).
	"triggers": { "crons": ["17 3 * * *"] },
	// Variables and secrets set in the Cloudflare dashboard (INDEXNOW_KEY, REVALIDATE_SECRET) survive every deploy.
	"keep_vars": true,
	// Tells the Worker which deploy it is, so saved pages from an older deploy (which point at CSS and JS files that no
	// longer exist) are never served after a new deploy.
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"routes": [
		{
			"pattern": "notesandpapers.dpdns.org",
			"custom_domain": true
		},
		{
			"pattern": "www.notesandpapers.dpdns.org",
			"custom_domain": true
		}
	],
	"vars": {
		"INDEXNOW_KEY": "d8e8d88bcb06e2901c2031fe56889b39",
		"NEXT_PUBLIC_SITE_URL": "https://notesandpapers.dpdns.org",
		"NEXT_PUBLIC_API_URL": "https://backend.notesandpapers.dpdns.org/api/v1"
	},
	"observability": {
		"enabled": true
	}
}